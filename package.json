{
  "name": "@c9up/prism",
  "version": "0.1.0",
  "description": "Prism \u2014 image processing for the Ream framework: resize, convert, crop, composite and watermark, on a Rust engine (TypeScript + Rust N-API)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.*.node",
    "scripts",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/PrismProvider.ts",
      "import": "./src/PrismProvider.ts"
    },
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    },
    "./testing": {
      "types": "./src/testing/main.ts",
      "import": "./src/testing/main.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:napi": "cargo build --release -p prism-engine-napi && pnpm build:napi-types && node scripts/copy-napi.mjs",
    "build:napi-types": "node scripts/build-napi-types.mjs",
    "test": "vitest run",
    "test:rust": "cargo test",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@c9up/ream": "^0.2.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@c9up/ream": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/PrismProvider.d.ts",
        "import": "./dist/PrismProvider.js"
      },
      "./configure": {
        "types": "./dist/configure.d.ts",
        "import": "./dist/configure.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      },
      "./testing": {
        "types": "./dist/testing/main.d.ts",
        "import": "./dist/testing/main.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/prism.git"
  }
}
